# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor / agent tooling
.agents/
.claude/
.windsurf/
.cursor/
skills-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local data & secrets
/data/*
!/data/.gitkeep
/secrets/*
!/secrets/.gitignore
!/secrets/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client
/src/generated/prisma

# Go + Vite
/web/node_modules
/backend/data/
/backend/zorth-deploy-hub
/zorth-deploy-hub
/dist/
/backend/internal/static/dist/assets/
/backend/internal/static/dist/favicon.svg
/backend/internal/static/dist/icons.svg
